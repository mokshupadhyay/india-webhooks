{
  "name": "india-webhooks",
  "version": "0.1.0",
  "description": "Verify and normalise payment webhooks from Razorpay, Cashfree, PhonePe, PayU, Juspay and Easebuzz, with a test kit that signs requests the same way the gateways do. Web Crypto, zero runtime dependencies.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./razorpay": {
      "import": {
        "types": "./lib/typescript/module/razorpay.d.ts",
        "default": "./lib/module/razorpay.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/razorpay.d.ts",
        "default": "./lib/commonjs/razorpay.js"
      }
    },
    "./cashfree": {
      "import": {
        "types": "./lib/typescript/module/cashfree.d.ts",
        "default": "./lib/module/cashfree.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/cashfree.d.ts",
        "default": "./lib/commonjs/cashfree.js"
      }
    },
    "./phonepe": {
      "import": {
        "types": "./lib/typescript/module/phonepe.d.ts",
        "default": "./lib/module/phonepe.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/phonepe.d.ts",
        "default": "./lib/commonjs/phonepe.js"
      }
    },
    "./payu": {
      "import": {
        "types": "./lib/typescript/module/payu.d.ts",
        "default": "./lib/module/payu.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/payu.d.ts",
        "default": "./lib/commonjs/payu.js"
      }
    },
    "./juspay": {
      "import": {
        "types": "./lib/typescript/module/juspay.d.ts",
        "default": "./lib/module/juspay.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/juspay.d.ts",
        "default": "./lib/commonjs/juspay.js"
      }
    },
    "./easebuzz": {
      "import": {
        "types": "./lib/typescript/module/easebuzz.d.ts",
        "default": "./lib/module/easebuzz.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/easebuzz.d.ts",
        "default": "./lib/commonjs/easebuzz.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./lib/typescript/module/testing.d.ts",
        "default": "./lib/module/testing.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/testing.d.ts",
        "default": "./lib/commonjs/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "razorpay": ["lib/typescript/commonjs/razorpay.d.ts"],
      "cashfree": ["lib/typescript/commonjs/cashfree.d.ts"],
      "phonepe": ["lib/typescript/commonjs/phonepe.d.ts"],
      "payu": ["lib/typescript/commonjs/payu.d.ts"],
      "juspay": ["lib/typescript/commonjs/juspay.d.ts"],
      "easebuzz": ["lib/typescript/commonjs/easebuzz.d.ts"],
      "testing": ["lib/typescript/commonjs/testing.d.ts"]
    }
  },
  "sideEffects": false,
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/india-webhooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/india-webhooks.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/india-webhooks/issues"
  },
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "webhook",
    "webhooks",
    "signature",
    "verification",
    "hmac",
    "razorpay",
    "cashfree",
    "phonepe",
    "payu",
    "juspay",
    "easebuzz",
    "payments",
    "india",
    "upi"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
